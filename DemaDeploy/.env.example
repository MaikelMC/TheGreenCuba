# La Verde — Preview Experience
# Copia este archivo a `.env` y ajusta los valores.

# --- Versión pública (opcional) ---
# URL pública de tu despliegue (para Open Graph / metadata absoluta).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Waitlist (opcional) ---
# Almacenamiento gratuito en Vercel para la waitlist.
# Opción A: Vercel Blob (recomendado para MVP).
#   1. Ve a Storage > Create Database > Blob, copia su read/write token.
#   2. DIRECCIONADOR_CONTAINER_BLOB vendrá en el endpoint del Storage.
VERCEL_BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx

# Opción B: SheetBest (hoja de cálculo gratuita, sin backend).
#   Crea una Google Sheet y conecta SheetBest para GET/POST.
#   https://sheet.best
SHEETBEST_URL=

# --- Notificaciones de la waitlist ---
# 1) Telegram (te avisa cuando alguien pide un cupo):
TELEGRAM_BOT_TOKEN=   # token del bot, sácalo de @BotFather
TELEGRAM_CHAT_ID=     # tu chat_id personal (mensajeá al bot y pregúntale a @userinfobot)

# 2) Google Sheets (guarda cada cupo en tu hoja):
#    Cuenta de servicio: Google Cloud Console → habilita "Google Sheets API" → crea
#    una cuenta de servicio → descarga el JSON → comparte tu hoja con su email (Editor).
#    Pega aquí el JSON completo en una sola línea (minificado).
GOOGLE_SERVICE_ACCOUNT_JSON=
#    Id del spreadsheet (el trozo del URL: /spreadsheets/d/<ID>/)
WAITLIST_SPREADSHEET_ID=
#    Rango de la pestaña donde se guarda (opcional, por defecto "Cupos!A:E")
WAITLIST_SHEET_RANGE=Cupos!A:E

# --- Prompt de la demo de IA (opcional) ---
# Token para el endpoint de IA. Si se deja vacío, la demo usa respuestas locales (modo démo).
OPENAI_API_KEY=

# Tipo de proveedor de IA ("openai" | "local"). Por defecto "local".
AI_MODE=local