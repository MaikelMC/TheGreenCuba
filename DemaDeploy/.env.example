# La Verde — Preview Experience
# Copia este archivo a `.env` y ajusta los valores.

# --- Versión pública (opcional) ---
# URL pública de tu despliegue (para Open Graph / metadata absoluta).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Waitlist (opcional) ---
# Almacenamiento gratuito en Vercel para la waitlist.
# Opción A: Vercel Blob (recomendado para MVP).
#   1. Ve a Storage > Create Database > Blob, copia su read/write token.
#   2. DIRECCIONADOR_CONTAINER_BLOB vendrá en el endpoint del Storage.
VERCEL_BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx

# Opción B: SheetBest (hoja de cálculo gratuita, sin backend).
#   Crea una Google Sheet y conecta SheetBest para GET/POST.
#   https://sheet.best
SHEETBEST_URL=

# --- Prompt de la demo de IA (opcional) ---
# Token para el endpoint de IA. Si se deja vacío, la demo usa respuestas locales (modo démo).
OPENAI_API_KEY=

# Tipo de proveedor de IA ("openai" | "local"). Por defecto "local".
AI_MODE=local