# ─── Base ───
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Base de datos (Neon) ───
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/la-verde?sslmode=require

# ─── Administración ───
# Sigue valiendo para las rutas de API de administración (cabecera `x-admin-key`).
# El panel ya no la usa: entra por /login con la cuenta de administrador.
ADMIN_KEY=my-secret-admin-key

# ─── Autenticación (Neon Managed Auth) ───
# Las cuentas, las contraseñas y las sesiones viven en Neon, en el esquema
# `neon_auth` de vuestra base. Aquí no hay ninguna credencial.
#
# Antes de rellenar esto hay que ACTIVAR Auth en el proyecto, desde la consola
# de Neon, y copiar los dos valores de:
#   Neon Console → Project → Branch → Auth → Configuration
#
# URL del servicio de autenticación de vuestra rama. Cada rama tiene la suya, y
# termina en /auth.
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth

# Firma la cookie de sesión con HMAC-SHA256. Neon pide 32 caracteres o más.
# Genera uno con:   openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=change-me-please-with-32-characters-minimum

# La MISMA URL que NEON_AUTH_BASE_URL, pero expuesta al navegador. Son dos
# variables y no una porque una lleva el prefijo NEXT_PUBLIC_ y la otra no: la
# primera acaba en el bundle del cliente, la segunda se queda en el servidor.
# El cliente la lee solo —createAuthClient() no toma argumentos— y
# next.config.ts la usa para abrir el `connect-src` del CSP. Si falta, el login
# funciona en desarrollo y el navegador lo bloquea en producción sin decir por qué.
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth

# Rol inicial, por correo: `correo=rol` separado por comas. Roles válidos:
# user, owner, admin.
#
# Se aplica SOLO la primera vez que esa persona entra, al crearse su fila en
# `users`. Después el rol se cambia en la tabla, no aquí. Hace falta un punto de
# entrada: sin esto no habría manera de que existiera un administrador, y
# /admin y /business quedarían cerrados para siempre.
AUTH_BOOTSTRAP_ROLES=admin@laverde.cu=admin,negocio@laverde.cu=owner

# ─── Autenticación (retirada) ───
# AUTH_SECRET firmaba la cookie `lv_session` y DEMO_*_PASSWORD daban contraseña a
# las tres cuentas de src/lib/accounts.ts. Ese archivo y esa cookie ya no
# existen: los sustituye Neon Managed Auth. Las variables de Clerk tampoco:
# @clerk/nextjs nunca llegó a ser dependencia.

# ─── Proveedores de IA (búsqueda inteligente / asistente) ───
# La primera vez que se accede al panel se siembran automáticamente en
# data/ai-providers.json desde estas claves. Puedes activar/desactivar y editar
# modelos desde el administrador (pestaña "Proveedores de IA").
#
# Mistral (OpenAI-compatible, plan gratis) — se activa por defecto.
MISTRAL_API_KEY=xxx
MISTRAL_MODEL=mistral-small-latest
#
# OpenRouter (OpenAI-compatible; usa modelos :free) — desactivado por defecto.
OPENROUTER_API_KEY=sk-or-xxx
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
#
# Google Gemini (X-goog-api-key, /generateContent) — activo por defecto.
# Usa la familia "lite": los gemini-2.5-* dan 404 en cuentas nuevas y los
# gemini-3.x-flash devuelven 503 por demanda alta.
GEMINI_API_KEY=xxx
GEMINI_MODEL=gemini-flash-lite-latest
#
# Cerebras (compatible con OpenAI: Bearer + /chat/completions, soporta
# response_format json_object) — activo por defecto. Modelos disponibles en la
# cuenta: gpt-oss-120b, qwen-3.8-27b, gemma-4-31b.
CEREBRAS_API_KEY=csk-xxx
CEREBRAS_MODEL=gpt-oss-120b

# ─── Cloudflare Workers AI (embeddings + búsqueda por lenguaje natural) ───
# Los identificadores viven en Cloudflare/IDs.txt, que NO se sube (está en
# .gitignore). Copia los valores aquí, nunca al revés.
# El token de la carpeta es de cuenta completa: para producción conviene uno
# limitado a la cuenta y al permiso "Workers AI".
CLOUDFLARE_ACCOUNT_ID=xxx
CLOUDFLARE_API_TOKEN=xxx

# ─── Storage (Cloudflare R2) ───
R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=la-verde-images
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ─── UploadThing (alternativa) ───
UPLOADTHING_SECRET=sk_live_xxx
UPLOADTHING_APP_ID=xxx

# ─── Analytics (post-MVP) ───
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_GA_ID=G-xxxxx
