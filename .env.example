# ─── Base ───
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Base de datos (Neon) ───
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/la-verde?sslmode=require

# ─── Administración ───
ADMIN_KEY=my-secret-admin-key

# ─── Autenticación (Clerk) ───
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# ─── Proveedores de IA (búsqueda inteligente / asistente) ───
# La primera vez que se accede al panel se siembran automáticamente en
# data/ai-providers.json desde estas claves. Puedes activar/desactivar y editar
# modelos desde el administrador (pestaña "Proveedores de IA").
#
# Mistral (OpenAI-compatible, plan gratis) — se activa por defecto.
MISTRAL_API_KEY=xxx
MISTRAL_MODEL=mistral-small-latest
#
# OpenRouter (OpenAI-compatible; usa modelos :free) — desactivado por defecto.
OPENROUTER_API_KEY=sk-or-xxx
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
#
# Google Gemini (X-goog-api-key, /generateContent) — desactivado por defecto.
GEMINI_API_KEY=xxx
GEMINI_MODEL=gemini-flash-latest

# ─── Storage (Cloudflare R2) ───
R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=la-verde-images
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ─── UploadThing (alternativa) ───
UPLOADTHING_SECRET=sk_live_xxx
UPLOADTHING_APP_ID=xxx

# ─── Analytics (post-MVP) ───
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_GA_ID=G-xxxxx
